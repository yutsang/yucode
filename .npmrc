# Nothing in this tree may run an install script or pull a prebuilt binary.
# The target machine is a locked-down Windows box whose endpoint protection
# quarantines freshly created unsigned .exe/.node files, so a postinstall that
# downloads one does not fail loudly -- it fails after deployment.
#
# save-exact removes the second way a binary arrives: a caret range that
# resolves to a new minor with a native optional dependency.
ignore-scripts=true
save-exact=true
omit=optional
audit=true
fund=false
